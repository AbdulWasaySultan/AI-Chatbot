# FJ-Tech Solutions — AI Platform environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------- API
# Express API port for local development (Next.js uses 3000).
API_PORT=4000

# Public URL of the dashboard. Login cookies are issued for this origin.
APP_URL=http://localhost:3000

# Postgres connection string. For local development you can use the embedded database:
#   pglite://.data/dev-db   (persistent, created automatically, seeded with demo data)
#   pglite://memory         (throwaway)
# Production needs a real Postgres server, e.g. postgres://user:pass@host:5432/db
DATABASE_URL=pglite://.data/dev-db

# Signs session cookies. Required in production: at least 32 random characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Optional: "Sign in with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The old unauthenticated demo endpoints (/api/state, /api/simulate/webhook, …) used by the
# current dashboard. On by default in development, always off in production.
# LEGACY_DEMO_API=true

# ---------------------------------------------------------------- AI
# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini models. gemini-2.0-* models are deprecated by Google; check
# https://ai.google.dev/gemini-api/docs/deprecations for current model IDs.
# (Not used by the agent engine yet — wired up in Phase 2 of plans/14-roadmap.md.)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_SEARCH_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------- Web
# Where Next.js forwards /api/* requests. Defaults to http://localhost:4000 in
# development; required in production.
BACKEND_URL=http://localhost:4000

NODE_ENV=development
