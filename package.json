{
  "name": "fj-tech-platform",
  "version": "2.0.0",
  "private": true,
  "description": "FJ-Tech multi-tenant AI agent platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @fj/web",
    "dev:api": "npm run dev -w @fj/api",
    "build": "npm run build -w @fj/web",
    "start:web": "npm run start -w @fj/web",
    "start:api": "npm run start -w @fj/api",
    "db:generate": "npm run db:generate -w @fj/api",
    "db:migrate": "npm run db:migrate -w @fj/api",
    "db:seed": "npm run db:seed -w @fj/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w @fj/api -w @fj/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
